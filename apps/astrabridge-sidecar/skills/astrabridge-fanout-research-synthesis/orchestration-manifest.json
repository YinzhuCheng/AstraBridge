{
  "schema_version": "astrabridge-skill-to-graph-manifest-v1",
  "skill_id": "astrabridge.fanout-research-synthesis",
  "version": "1.0.0",
  "kind": "orchestration_skill",
  "status": "candidate",
  "metadata": {
    "display_name": "Fan-out Research / Synthesis",
    "description": "Fixed two-branch public research with attributable artifact-first synthesis.",
    "tags": ["research", "fanout", "synthesis", "attribution"],
    "owners": ["astrabridge-core"],
    "notes": ["v1 fixes branch count at two and denies recursive fan-out."]
  },
  "resolution": {
    "mode": "builtin_template",
    "graph_template_ref": "fanout_fanin_research",
    "graph_schema_version": "astrabridge-agent-orchestration-graph-v1",
    "parameter_schema": {
      "type": "object",
      "properties": {
        "research_goal": {"type": "string", "minLength": 1, "maxLength": 8000},
        "branch_scopes": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}, "minItems": 2, "maxItems": 2},
        "source_domains": {"type": "array", "items": {"type": "string", "maxLength": 128}, "maxItems": 12},
        "query_budget": {"type": "integer", "minimum": 1, "maximum": 16}
      },
      "required": ["research_goal", "branch_scopes"],
      "additionalProperties": false
    },
    "bindings": [
      {"parameter": "research_goal", "graph_path": "input.task_context", "required": true},
      {"parameter": "branch_scopes", "graph_path": "input.branch_plan", "required": true},
      {"parameter": "source_domains", "graph_path": "nodes.node_branch_a.prompt", "required": false},
      {"parameter": "query_budget", "graph_path": "nodes.node_branch_b.prompt", "required": false}
    ]
  },
  "prompt": {
    "mode": "reference",
    "template_ref": "prompt.fanout_research_synthesis.v1",
    "variables_schema": {
      "type": "object",
      "properties": {
        "research_goal": {"type": "string"},
        "branch_scopes": {"type": "array", "minItems": 2, "maxItems": 2},
        "source_domains": {"type": "array"},
        "query_budget": {"type": "integer"}
      },
      "required": ["research_goal", "branch_scopes"],
      "additionalProperties": false
    }
  },
  "contracts": {
    "input": {
      "schema_ref": "schema.skill_research_input",
      "required_message_parts": ["text", "structured_json"],
      "artifact_specs": []
    },
    "output": {
      "schema_ref": "schema.research_synthesis",
      "required_message_parts": ["machine_result", "human_summary", "artifact_ref"],
      "artifact_specs": [
        {"kind": "text_report", "id": "branch_a_report"},
        {"kind": "text_report", "id": "branch_b_report"},
        {"kind": "run_summary", "id": "research_synthesis"}
      ]
    }
  },
  "policies": {
    "routing": {
      "selection_mode": "bounded_pool",
      "allowed_provider_ids": ["qwen", "kimi"],
      "allowed_model_ids": ["qwen3.7-plus", "qwen3-coder-plus", "kimi-k2.6"],
      "fallback_mode": "catalog_verified",
      "required_capabilities": ["text", "structured_json", "web_search"]
    },
    "mcp": {
      "preset_ids": ["astrabridge_web"],
      "tool_rules": [
        {"server": "astrabridge_web", "tools": ["astrabridge_web_search_batch", "astrabridge_web_research_brief", "astrabridge_web_fetch"], "approval_mode": "allow", "effect_class": "network_read", "max_calls": 16}
      ],
      "approval_mode": "ask",
      "loopback_allowed": true
    },
    "communication": {
      "history_mode": "explicit_refs_only",
      "artifact_mode": "explicit_artifacts",
      "exclude_private_memory": true,
      "include_machine_results": true,
      "include_human_summaries": true,
      "allow_direct_teammate_messages": false
    },
    "subagent": {
      "isolation_mode": "lane",
      "max_turns": 8,
      "allow_nested_subagents": false,
      "allow_direct_teammate_messages": false
    },
    "budget": {
      "max_total_agents": 4,
      "max_parallel_agents": 2,
      "max_total_tokens": 100000,
      "max_provider_calls": 6,
      "max_retries": 2,
      "provider_concurrency": [
        {"provider_id": "qwen", "max_active_agents": 1},
        {"provider_id": "kimi", "max_active_agents": 1}
      ],
      "model_concurrency": [
        {"provider_id": "qwen", "model_id": "qwen3.7-plus", "max_active_agents": 1},
        {"provider_id": "kimi", "model_id": "kimi-k2.6", "max_active_agents": 1}
      ]
    },
    "approval": {
      "default_mode": "ask",
      "risky_effects_require_approval": ["provider_call", "external_write"]
    },
    "a2a": {
      "external_enabled": false,
      "allowed_card_refs": [],
      "minimum_trust_level": "workspace_trusted",
      "gateway_required": true
    }
  },
  "composition": {
    "allow_runtime_nesting": false,
    "max_expansion_depth": 1,
    "template_refs": []
  },
  "compatibility": {
    "graph_schema_version": "astrabridge-agent-orchestration-graph-v1",
    "min_runtime_version": "0.1.0",
    "legacy_sources": ["astrabridge-task-graph-v1"],
    "migration_notes": ["The standalone web lane remains separate from model-backed capability routing."]
  },
  "evidence": {
    "required_level": "productized",
    "fixture_ref": "fixture.fanout_fanin_research",
    "artifact_root": "PRIVATE/skill-first-orchestration/step6-skill-templates/"
  },
  "extensions": {
    "taxonomy_version": "astrabridge-skill-template-taxonomy-v1",
    "template_id": "fanout_fanin_research",
    "fixed_branch_count": 2
  }
}
