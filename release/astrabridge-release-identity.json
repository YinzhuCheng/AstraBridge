      "resource_destination": "astrabridge-sidecar",
      "launcher_path": "python-runtime/python.exe",
      "launch_arguments": [
        "-m",
        "astrabridge_sidecar.server"
      ],
      "pythonpath_entry": ".",
      "package_root": "astrabridge_sidecar",
      "skills_root": "skills",
      "origin": "app_managed",
      "launcher_mode": "desktop-app-managed",
      "allow_source_fallback_in_formal_package": false
    }
  },
  "protocol": {
    "schema_version": "astrabridge-protocol-v1",
    "compatibility_manifest_path": "apps/astrabridge-sidecar/astrabridge_sidecar/protocol/compatibility_manifest.json"
  },
  "mcp": {
    "server_names": [
