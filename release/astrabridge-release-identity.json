    "default_channel": "stable",
    "kill_switch": {
      "manifest_path": "release/updater/kill-switch.json",
      "default_mode": "allow",
      "allow_disable_updates": true
    },
    "channels": [
      {
        "channel": "stable",
        "manifest_path": "release/updater/stable.json",
