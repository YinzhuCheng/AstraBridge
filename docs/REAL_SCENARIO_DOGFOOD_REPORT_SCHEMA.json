{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://astrabridge.local/schemas/real-scenario-dogfood-report-v1.json",
  "title": "AstraBridge Real Scenario Dogfood Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "step_id",
    "capability",
    "scenario_id",
    "trigger_path",
    "status",
    "started_at",
    "completed_at",
    "screenshots",
    "artifacts",
    "verification_commands"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "astrabridge-real-scenario-dogfood-report-v1"
    },
    "plan_id": {
      "type": "string",
      "const": "capability_real_scenario_dogfood"
    },
    "step_id": {
      "type": "string",
      "pattern": "^step_[0-9]{2}$"
    },
    "capability": {
      "type": "string",
      "enum": [
        "automations",
        "plugins",
        "skills",
        "multimodal-routes",
        "web",
        "cross-capability"
      ]
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "trigger_path": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "partial",
        "fail",
        "timeout",
        "skipped"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "failure_reason": {
      "type": "string",
      "minLength": 3
    },
    "skip_reason": {
      "type": "string",
      "minLength": 3
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/screenshotRef"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/artifactRef"
      }
    },
    "verification_commands": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/verificationCommand"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "screenshotRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "entry",
            "running",
            "success",
            "failure",
            "detail",
            "reference"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 3
        },
        "note": {
          "type": "string"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "role",
        "path",
        "sensitive"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "report",
            "record",
            "manifest",
            "log",
            "image",
            "audio",
            "document",
            "json",
            "other"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 3
        },
        "path": {
          "type": "string",
          "minLength": 3
        },
        "sensitive": {
          "type": "boolean",
          "const": false
        },
        "note": {
          "type": "string"
        }
      }
    },
    "verificationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "cwd",
        "summary"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "fail",
              "timeout"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "failure_reason"
        ],
        "properties": {
          "screenshots": {
            "contains": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "failure"
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "skipped"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "skip_reason"
        ]
      }
    }
  ]
}
